# Telegram bot that receives "Join the society" form submissions.
# 1. Message @BotFather → /newbot → copy the token.
# 2. Message your bot (or add it to a group), then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Transactional signup confirmation, sent after Telegram receives the request.
# Use a verified Postmark sender address (bare email, without a display name).
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
