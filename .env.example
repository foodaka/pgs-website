# Flagstick (Supabase) project that stores "Join the society" requests for
# admins to invite or decline at flagstick.live/admin/members/requests.
# Use the project's public ANON key — it can only call
# submit_membership_request(), never read the table. Never the service key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: which society the requests belong to (default "pgs").
SOCIETY_SLUG=

# Telegram bot that receives "Join the society" form submissions.
# 1. Message @BotFather → /newbot → copy the token.
# 2. Message your bot (or add it to a group), then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Transactional signup confirmation, sent once the request is saved or notified.
# Use a verified Postmark sender address (bare email, without a display name).
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
